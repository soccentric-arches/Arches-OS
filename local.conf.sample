CONF_VERSION = "2"
MACHINE ??= "jetson-tx1-devkit"
DISTRO ?= "poky"
IMAGE_FSTYPES ?= "ext4 tegraflash"
# Shared caches — inside the build dir, matching kas/common.yaml
DL_DIR ?= "${TOPDIR}/downloads"
SSTATE_DIR ?= "${TOPDIR}/sstate-cache"
LICENSE_FLAGS_ACCEPTED:append = " commercial"
require ${TOPDIR}/../meta/meta-arches/arches.inc