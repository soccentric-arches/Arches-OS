# Arches-OS — Thor generation bblayers.conf template.
#
# Works unedited after kas checkout has populated layers/ and meta/.
# Mirrors the layer set in kas/common.yaml + kas/repos/*.yaml.
# Note: OE-Core/bitbake/meta-yocto are split repositories at the whinlatter
# release (the poky combo repo no longer carries that series).

LCONF_VERSION = "7"

BBPATH = "${TOPDIR}"
BBFILES ?= ""

BBLAYERS ?= " \
  ${TOPDIR}/../layers/openembedded-core/meta \
  ${TOPDIR}/../layers/meta-yocto/meta-poky \
  ${TOPDIR}/../layers/meta-yocto/meta-yocto-bsp \
  ${TOPDIR}/../layers/meta-openembedded/meta-oe \
  ${TOPDIR}/../layers/meta-openembedded/meta-python \
  ${TOPDIR}/../layers/meta-openembedded/meta-networking \
  ${TOPDIR}/../layers/meta-openembedded/meta-multimedia \
  ${TOPDIR}/../layers/meta-openembedded/meta-filesystems \
  ${TOPDIR}/../layers/meta-tegra \
  ${TOPDIR}/../layers/meta-swupdate \
  ${TOPDIR}/../layers/meta-rust-bin \
  ${TOPDIR}/../meta/meta-arches \
  "